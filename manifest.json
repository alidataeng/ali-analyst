{
  "manifest_version": 3,
  "name": "Solana Meme Token Analyzer",
  "version": "0.1.0",
  "description": "Analyzes Solana meme tokens.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "alarms"
  ],
  "icons": {
    "128": "images/icon128.png"
  },
  "host_permissions": [
    "https://public-api.birdeye.so/*",
    "https://public-api.solscan.io/*",
    "https://api.social-listening-service.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
